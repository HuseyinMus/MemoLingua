rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    // Check if the user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the authenticated user matches the document ID
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- RULES ---

    // 1. USER PRIVATE DATA
    // Allows full access to the user's own data and all subcollections (words, history, sessions, etc.)
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // 2. LEADERBOARD (PUBLIC READ, OWNER WRITE)
    // Allows all authenticated users to read the leaderboard to see rankings.
    // Allows users to update ONLY their own score/entry.
    match /leaderboard/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // 3. DEFAULT DENY
    // Explicitly deny access to any other documents not matched above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
