
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- YARDIMCI FONKSİYONLAR ---
    
    // Kullanıcının giriş yapıp yapmadığını kontrol eder
    function isSignedIn() {
      return request.auth != null;
    }

    // İşlem yapan kişinin, verinin sahibi olup olmadığını kontrol eder
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- KURALLAR ---

    // 1. KULLANICI VERİLERİ (ÖZEL ALAN)
    // Bu kural, 'users' koleksiyonundaki ana dokümanı VE onun altındaki 
    // tüm alt koleksiyonları (words, history, voiceSessions, settings vb.) kapsar.
    // {document=**} "recursive wildcard" sayesinde tek kural ile tüm alt yapıyı koruyoruz.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // 2. LİDERLİK TABLOSU (YARI GENEL ALAN)
    // Oyun/Arena modunda sıralamayı göstermek için kullanılır.
    match /leaderboard/{userId} {
      // OKUMA: Giriş yapmış herhangi bir kullanıcı, sıralamayı görmek için 
      // diğer kullanıcıların skorlarını okuyabilir.
      allow read: if isSignedIn();
      
      // YAZMA: Bir kullanıcı sadece KENDİ skorunu veya bilgilerini güncelleyebilir.
      // Başkasının skorunu değiştiremez.
      allow write: if isOwner(userId);
      
      // İsteğe bağlı: Veri doğrulama eklenebilir (örn: XP negatif olamaz)
      // allow write: if isOwner(userId) && request.resource.data.xp >= 0;
    }
  }
}
