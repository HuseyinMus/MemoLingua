# MemoLingua Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Gemini AI Configuration
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# AdMob Configuration (Capacitor)
VITE_ADMOB_APP_ID=ca-app-pub-8047230624362046~1926038687
VITE_ADMOB_BANNER_ID=ca-app-pub-8047230624362046/8741910236
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-8047230624362046/1901347326
VITE_ADMOB_REWARDED_ID=ca-app-pub-8047230624362046/4335938971 # Note: User provided Native ID, placed here or as custom
VITE_ADMOB_NATIVE_ID=ca-app-pub-8047230624362046/4335938971

# Instructions:
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in your actual API keys
# 3. Never commit .env.local to version control
# 4. Get Firebase config from: https://console.firebase.google.com
# 5. Get Gemini API key from: https://makersuite.google.com/app/apikey
# 6. Get AdMob IDs from: https://apps.admob.com
